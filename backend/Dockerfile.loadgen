# Build stage
FROM golang:1.21-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git
COPY loadgen/go.mod loadgen/go.sum ./
RUN go mod download
COPY loadgen/*.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o loadgen .

# Runtime stage
FROM alpine:3.18
RUN apk add --no-cache ca-certificates curl bash
WORKDIR /app
COPY --from=builder /app/loadgen .
CMD ["./loadgen", "--help"]
